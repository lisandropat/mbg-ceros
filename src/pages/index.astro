---
import BaseLayout from "../layouts/BaseLayout.astro";
import SiteNav from "../components/SiteNav.astro";
import SiteFooter from "../components/SiteFooter.astro";
import ArticleCard from "../components/ArticleCard.astro";
import { sortedArticles, organizationLd, websiteLd, SITE } from "../data/articles";

const [featured, ...rest] = sortedArticles();
---

<BaseLayout
  title="Articles | mindbodygreen"
  description="Latest articles from mindbodygreen."
  canonical={`${SITE}/`}
  image={featured?.image ?? ""}
  type="website"
  jsonLd={[organizationLd, websiteLd]}
>
  <main>
    <SiteNav />

    <section id="content" class="mx-auto max-w-7xl px-4 py-10 md:px-8 md:py-16">
      <h1 class="mb-10 border-b border-black pb-4 font-serif text-4xl md:text-6xl">Articles</h1>

      {
        featured ? (
          <>
            <ArticleCard article={featured} featured />

            {rest.length > 0 && (
              <div class="mt-16 grid gap-x-8 gap-y-12 sm:grid-cols-2 lg:grid-cols-3">
                {rest.map((article) => (
                  <ArticleCard article={article} />
                ))}
              </div>
            )}
          </>
        ) : (
          <p class="text-black/60">No articles yet.</p>
        )
      }
    </section>

    <SiteFooter />
  </main>
</BaseLayout>
