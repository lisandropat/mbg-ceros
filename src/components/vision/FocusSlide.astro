---
import type { ImageMetadata } from "astro";
import { Image } from "astro:assets";
import SeeMoreButton from "./SeeMoreButton.astro";
import MobileHalfBg from "./MobileHalfBg.astro";
import CaretUp from "@phosphor-icons/core/assets/light/caret-up-light.svg";

export interface Hotspot {
  label: string;
  image: ImageMetadata;
  left: string;
  top: string;
  width: string;
  popupWidth: string;
  html: string;
}

export interface Citation {
  label: string;
  href: string;
}

export interface Props {
  id: string;
  bg: ImageMetadata;
  title: { image: ImageMetadata; alt: string; left: string; top: string; width: string };
  bodyHtml: string;
  hotspots: Hotspot[];
  citations: Citation[];
  next: string;
  bodyTop?: string;
  seeMoreTop?: string;
  citationsTop?: string;
  citationsInset?: string;
}

const {
  id,
  bg,
  title,
  bodyHtml,
  hotspots,
  citations,
  next,
  bodyTop = "23.2cqw",
  seeMoreTop = "106.3cqw",
  citationsTop = "109.8cqw",
  citationsInset = "20%",
} = Astro.props;

const body = bodyHtml.replaceAll("<br />", ' <br class="max-md:hidden" />');
---

<section class="@container relative isolate w-full overflow-hidden text-white md:aspect-[1351/1533]" aria-labelledby={`${id}-title`}>
  <Image
    src={bg}
    alt=""
    widths={[768, 1280, 1920, 3168]}
    sizes="107vw"
    loading="eager"
    class="absolute -left-[3.2%] -top-[1.04cqw] -z-10 h-[calc(100%+1.04cqw)] w-[106.4%] max-w-none object-cover object-top max-md:hidden"
  />

  <div class="relative isolate flex min-h-svh flex-col items-center justify-center gap-7 overflow-hidden px-7 py-16 md:contents">
    <MobileHalfBg src={bg} half="top" />

    <h2
      id={`${id}-title`}
      class="w-[80%] max-w-[360px] md:absolute md:left-(--l) md:top-(--t) md:w-(--w) md:max-w-none"
      style={`--l:${title.left};--t:${title.top};--w:${title.width}`}
    >
      <Image src={title.image} alt={title.alt} widths={[title.image.width / 2, title.image.width]} sizes="(min-width: 768px) 31vw, 80vw" data-reveal class="block w-full" />
    </h2>

    <span data-reveal style="--reveal-delay: 150ms" class="h-px w-16 bg-white md:absolute md:left-[46.1%] md:top-[19.8cqw] md:h-[16.1cqw] md:w-px" aria-hidden="true"></span>

    <p
      data-reveal
      style={`--reveal-delay: 300ms; --body-top:${bodyTop}`}
      class="max-w-[440px] text-center text-[16px] leading-snug md:absolute md:left-[51.2%] md:top-(--body-top) md:max-w-none md:whitespace-nowrap md:text-left md:text-[1.628cqw] md:leading-[1.1] [&_sup]:text-[0.6em]"
      set:html={body}
    />

    <a
      href={`#${id}-explore`}
      aria-label="Explore the scene"
      data-reveal
      style="--reveal-delay: 450ms"
      class="mt-4 w-9 transition-opacity hover:opacity-70 md:absolute md:left-1/2 md:top-[48.6cqw] md:mt-0 md:w-[3.6cqw] md:-translate-x-1/2"
    >
      <CaretUp aria-hidden="true" class="block w-full" />
    </a>
  </div>

  <div class="relative isolate flex min-h-svh flex-col items-center justify-end gap-5 overflow-hidden bg-black px-5 pb-10 pt-[38svh] md:contents">
    <MobileHalfBg src={bg} half="bottom" />

    <span id={`${id}-explore`} class="absolute top-0 md:top-[56cqw]" aria-hidden="true"></span>

    {
      hotspots.map((spot, i) => (
        <div
          class="group/spot relative z-10 flex w-full max-w-[440px] flex-col items-center has-[button[aria-expanded=true]]:z-20 md:absolute md:left-(--l) md:top-(--t) md:block md:w-(--w) md:max-w-none"
          style={`--l:${spot.left};--t:${spot.top};--w:${spot.width};--pw:${spot.popupWidth}`}
          data-hotspot
        >
          <button
            type="button"
            aria-expanded="false"
            aria-controls={`${id}-spot-${i}`}
            data-reveal
            style={`--reveal-delay: ${i * 120}ms`}
            class="block cursor-pointer transition-opacity hover:opacity-85 md:w-full"
          >
            <Image src={spot.image} alt={spot.label} widths={[spot.image.width / 2, spot.image.width]} sizes="(min-width: 768px) 18vw, 50vw" class="block h-[38px] w-auto md:h-auto md:w-full" />
          </button>
          <div
            id={`${id}-spot-${i}`}
            role="region"
            aria-label={spot.label}
            class:list={[
              "mt-2 hidden w-full rounded-md bg-black/60 px-4 py-3 text-center text-[15px] leading-snug [&_sup]:text-[0.6em]",
              "group-has-[button[aria-expanded=true]]/spot:block",
              "md:pointer-events-none md:invisible md:absolute md:left-1/2 md:top-full md:mt-[0.4cqw] md:block md:w-(--pw) md:-translate-x-1/2 md:translate-y-[0.6cqw] md:rounded-[0.4cqw] md:bg-black/55 md:px-[1.2cqw] md:py-[0.9cqw] md:text-[1.35cqw] md:leading-[1.17] md:opacity-0 md:transition-[opacity,translate,visibility] md:duration-300",
              "md:group-has-[button[aria-expanded=true]]/spot:pointer-events-auto md:group-has-[button[aria-expanded=true]]/spot:visible md:group-has-[button[aria-expanded=true]]/spot:translate-y-0 md:group-has-[button[aria-expanded=true]]/spot:opacity-100",
            ]}
            set:html={spot.html}
          />
        </div>
      ))
    }

    <SeeMoreButton href={next} top={seeMoreTop} delay="200ms" class="mt-5 md:mt-0" />

    <p
      class="max-w-[440px] text-center text-[10px] leading-snug md:absolute md:left-(--ci) md:right-(--ci) md:top-(--ct) md:max-w-none md:text-[max(9px,0.74cqw)] md:leading-[1.3]"
      style={`--ct:${citationsTop};--ci:${citationsInset}`}
    >
      Citations:{" "}
      {
        citations.map((c, i) => (
          <>
            {i + 1}){" "}
            <a href={c.href} target="_blank" rel="noopener" class="underline hover:opacity-70">
              {c.label}
            </a>
            {i < citations.length - 1 ? " " : ""}
          </>
        ))
      }
    </p>
  </div>
</section>

<script>
  document.querySelectorAll<HTMLElement>("[data-hotspot]").forEach((spot) => {
    const button = spot.querySelector("button");
    button?.addEventListener("click", () => {
      button.setAttribute("aria-expanded", String(button.getAttribute("aria-expanded") !== "true"));
    });
  });
</script>
