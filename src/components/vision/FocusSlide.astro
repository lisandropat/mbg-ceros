---
import type { ImageMetadata } from "astro";
import { Image } from "astro:assets";
import SeeMoreButton from "./SeeMoreButton.astro";
import CaretUp from "@phosphor-icons/core/assets/light/caret-up-light.svg";

export interface Hotspot {
  label: string;
  image: ImageMetadata;
  left: string;
  top: string;
  width: string;
  popupWidth: string;
  html: string;
}

export interface Citation {
  label: string;
  href: string;
}

export interface Props {
  id: string;
  bg: ImageMetadata;
  title: { image: ImageMetadata; alt: string; left: string; top: string; width: string };
  bodyHtml: string;
  hotspots: Hotspot[];
  citations: Citation[];
  next: string;
  bodyTop?: string;
  seeMoreTop?: string;
  citationsTop?: string;
  citationsInset?: string;
}

const {
  id,
  bg,
  title,
  bodyHtml,
  hotspots,
  citations,
  next,
  bodyTop = "23.2cqw",
  seeMoreTop = "106.3cqw",
  citationsTop = "109.8cqw",
  citationsInset = "20%",
} = Astro.props;
---

<section class="@container relative isolate aspect-[1351/1533] w-full overflow-hidden text-white" aria-labelledby={`${id}-title`}>
  <Image
    src={bg}
    alt=""
    widths={[768, 1280, 1920, 3168]}
    sizes="107vw"
    loading="eager"
    class="absolute -left-[3.2%] -top-[1.04cqw] -z-10 h-[calc(100%+1.04cqw)] w-[106.4%] max-w-none object-cover object-top"
  />

  <h2 id={`${id}-title`} class="absolute" style={`left:${title.left};top:${title.top};width:${title.width}`}>
    <Image src={title.image} alt={title.alt} widths={[title.image.width / 2, title.image.width]} sizes={title.width} data-reveal class="block w-full" />
  </h2>

  <span data-reveal style="--reveal-delay: 150ms" class="absolute left-[46.1%] top-[19.8cqw] h-[16.1cqw] w-px bg-white" aria-hidden="true"></span>

  <p
    data-reveal
    style={`--reveal-delay: 300ms; top:${bodyTop}`}
    class="absolute left-[51.2%] whitespace-nowrap text-[1.628cqw] leading-[1.1] [&_sup]:text-[0.6em]"
    set:html={bodyHtml}
  />

  <a
    href={`#${id}-explore`}
    aria-label="Explore the scene"
    data-reveal
    style="--reveal-delay: 450ms"
    class="absolute left-1/2 top-[48.6cqw] w-[3.6cqw] -translate-x-1/2 transition-opacity hover:opacity-70"
  >
    <CaretUp aria-hidden="true" class="block w-full" />
  </a>

  <span id={`${id}-explore`} class="absolute top-[56cqw]" aria-hidden="true"></span>

  {
    hotspots.map((spot, i) => (
      <div class="group/spot absolute z-10 has-[button[aria-expanded=true]]:z-20" style={`left:${spot.left};top:${spot.top};width:${spot.width}`} data-hotspot>
        <button
          type="button"
          aria-expanded="false"
          aria-controls={`${id}-spot-${i}`}
          data-reveal
          style={`--reveal-delay: ${i * 120}ms`}
          class="block w-full cursor-pointer transition-opacity hover:opacity-85"
        >
          <Image src={spot.image} alt={spot.label} widths={[spot.image.width / 2, spot.image.width]} sizes={spot.width} class="block w-full" />
        </button>
        <div
          id={`${id}-spot-${i}`}
          role="region"
          aria-label={spot.label}
          style={`width:${spot.popupWidth}`}
          class="pointer-events-none invisible absolute left-1/2 top-full mt-[0.4cqw] -translate-x-1/2 translate-y-[0.6cqw] rounded-[0.4cqw] bg-black/55 px-[1.2cqw] py-[0.9cqw] text-center text-[1.35cqw] leading-[1.17] opacity-0 transition-[opacity,translate,visibility] duration-300 group-has-[button[aria-expanded=true]]/spot:pointer-events-auto group-has-[button[aria-expanded=true]]/spot:visible group-has-[button[aria-expanded=true]]/spot:translate-y-0 group-has-[button[aria-expanded=true]]/spot:opacity-100 [&_sup]:text-[0.6em]"
          set:html={spot.html}
        />
      </div>
    ))
  }

  <SeeMoreButton href={next} style={`top:${seeMoreTop}`} delay="200ms" />

  <p class="absolute text-center text-[max(9px,0.74cqw)] leading-[1.3]" style={`top:${citationsTop};left:${citationsInset};right:${citationsInset}`}>
    Citations:{" "}
    {
      citations.map((c, i) => (
        <>
          {i + 1}){" "}
          <a href={c.href} target="_blank" rel="noopener" class="underline hover:opacity-70">
            {c.label}
          </a>
          {i < citations.length - 1 ? " " : ""}
        </>
      ))
    }
  </p>
</section>

<script>
  document.querySelectorAll<HTMLElement>("[data-hotspot]").forEach((spot) => {
    const button = spot.querySelector("button");
    button?.addEventListener("click", () => {
      button.setAttribute("aria-expanded", String(button.getAttribute("aria-expanded") !== "true"));
    });
  });
</script>
