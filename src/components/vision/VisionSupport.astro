---
import { Image } from "astro:assets";
import CaretLeft from "@phosphor-icons/core/assets/regular/caret-left.svg";
import CaretRight from "@phosphor-icons/core/assets/regular/caret-right.svg";
import ArrowRight from "@phosphor-icons/core/assets/light/arrow-right-light.svg";
import ArrowCounterClockwise from "@phosphor-icons/core/assets/regular/arrow-counter-clockwise.svg";
import title from "../../assets/vision/support-title.png";
import chris from "../../assets/vision/support-chris-smiley.png";
import number1 from "../../assets/vision/support-number-1.png";
import number2 from "../../assets/vision/support-number-2.png";
import number3 from "../../assets/vision/support-number-3.png";
import number4 from "../../assets/vision/support-number-4.png";
import number5 from "../../assets/vision/support-number-5.png";

export interface Props {
  start: string;
}
const { start } = Astro.props;

const vspDoctor = "https://www.vsp.com/eye-doctor?utm_source=mindbodygreen&utm_medium=article_paid&utm_campaign=gcc_general";
const link = (href: string, text: string) => `<a href="${href}" target="_blank" rel="noopener">${text}</a>`;

const tips = [
  {
    number: number1,
    title: "Get regular<br />comprehensive eye exams",
    size: "1.19cqw",
    paragraphs: [
      "You shouldn’t have to wait until something feels noticeably different to prioritize your eye health.",
      "Eye exams are about more than updating your prescription. Through a comprehensive eye exam, your eye doctor can assess how well you’re seeing and help detect changes in your vision and eye health before they become noticeable. “That includes the age-related eye conditions we watch for, such as cataracts, glaucoma, macular degeneration, and dry eye, along with systemic issues like diabetes and high blood pressure,” says Smiley. “Many of these have no noticeable symptoms in the early stages, which is exactly why routine exams matter.”",
      "In addition, eye exams can help illuminate broader health considerations. “During a comprehensive eye exam, your eye doctor looks beyond vision correction needs. We also evaluate the structure and function of the eyes, which can reveal signs of more than 270 health conditions,” says Smiley.<sup>1</sup>",
    ],
  },
  {
    number: number2,
    title: "Know what can<br />change with age",
    size: "1.49cqw",
    paragraphs: [
      "Changes in vision are a normal part of getting older, but that doesn’t mean they should be ignored.",
      "One common example is presbyopia, the gradual loss of the eye’s ability to focus on objects up close. “As we get older, the lens in our eye hardens and becomes less flexible, impacting how it focuses light on the retina,” says Smiley. You might notice yourself holding your phone farther away, needing brighter light to read, or struggling to shift your focus between near and far distances.",
    ],
  },
  {
    number: number3,
    title: "Find vision solutions<br />that evolve with you",
    size: "1.05cqw",
    paragraphs: [
      "If presbyopia is making it harder to see clearly at different distances, progressive lenses can help simplify everyday vision by combining multiple prescriptions into a single pair of glasses.",
      `${link("https://patient.unitylenses.com/", "Unity V3 Elite Progressive Lenses")} are designed to support vision across near, intermediate, and distance viewing, helping your eyes transition smoothly as your focus shifts throughout the day.`,
      "“This is especially common for people who already wear glasses for distance and begin to experience presbyopia, making close-up activities more difficult. Progressive lenses combine those prescriptions into one lens without the visible lines found in traditional bifocals or trifocals,” says Smiley.",
      "Because your vision needs are personal, working with an eye doctor can help determine the right solution for your eyes and lifestyle. They can also help you with the transition to progressive lenses, notes Smiley: “Most people adapt within a few days to a couple of weeks, and accurate measurements and a proper fit make a real difference in how quickly that happens.”",
      "<strong>Want to try progressive lenses?</strong>",
    ],
  },
  {
    number: number4,
    title: "Make vision care<br />easier to navigate",
    size: "1.49cqw",
    paragraphs: [
      "Being proactive is simpler when you know where to turn.",
      `With ${link("https://www.vsp.com/eye-doctor", "VSP Vision Care")}, members have access to comprehensive vision coverage and an extensive network of more than 44,000 eye doctors across the country who can provide personalized care as their needs evolve. VSP Vision Care also offers a ${link("https://www.vsp.com/offers/premier-edge-offers/glasses-and-sunglasses/Premier-Edge-Promise", "worry-free eyewear guarantee")} for added confidence in your vision care.`,
    ],
  },
  {
    number: number5,
    title: "Care for your eyes<br />holistically",
    size: "1.19cqw",
    paragraphs: [
      "Your eye health impacts your day-to-day life—and in the same way, your daily habits can impact your eyes.",
      "“Our eye health is closely connected to our overall well-being, so taking care of your whole body is one of the best ways to support vision for years to come,” says Smiley.",
      "When it comes to protecting your vision long-term, the basics go a long way.",
      "“Small, consistent habits can make a meaningful difference in your eye health. Wear UV-protective eyewear, manage chronic conditions like diabetes and high blood pressure, eat a diet with plenty of leafy greens and omega-3s, and stay physically active,” says Smiley. “Pair those habits with an annual eye exam and you have covered most of what is within your control.”",
      "<strong>Want more guidance on your vision health?</strong>",
    ],
  },
];
---

<section class="@container relative flex w-full flex-col gap-8 overflow-hidden bg-[#F7F7F4] px-6 py-12 text-black md:block md:aspect-[2576/1279] md:p-0" aria-labelledby="vision-support-title">
  <h2 id="vision-support-title" class="w-full max-w-[420px] md:absolute md:left-[9.32%] md:top-[4.35cqw] md:w-[35.9%] md:max-w-none">
    <Image src={title} alt="find the vision support you need" widths={[519, 1037]} sizes="(min-width: 768px) 36vw, 90vw" data-reveal class="block w-full" />
  </h2>

  <div data-reveal style="--reveal-delay: 150ms" class="text-[16px] leading-snug md:absolute md:left-[10.33%] md:top-[15.2cqw] md:whitespace-nowrap md:text-[1.2cqw] md:leading-[1.05] [&>p+p]:mt-[1lh] max-md:[&_br]:hidden">
    <p>There’s no single secret to aging well.</p>
    <p>It’s the everyday habits that help us continue moving, <br />connecting, exploring, creating, and participating in <br />the lives we’ve built. Vision health is woven through <br />all of them.</p>
    <p>So as you think about the health habits you want to <br />carry with you into the years ahead, make sure eye <br />care is part of the picture.</p>
    <p>Here’s where to start</p>
  </div>

  <div data-reveal style="--reveal-delay: 300ms" class="flex items-center gap-4 md:absolute md:left-[10.33%] md:top-[33.2cqw] md:gap-[1.6cqw]">
    <Image src={chris} alt="Chris Smiley, O.D." widths={[130, 260]} sizes="(min-width: 768px) 9vw, 88px" class="w-[88px] shrink-0 rounded-full md:w-[9.08cqw]" />
    <div class="md:whitespace-nowrap">
      <p class="text-[15px] leading-tight md:text-[1.3cqw] md:leading-[1.13]">Meet our expert:<br /><strong class="font-bold">Chris Smiley, O.D.</strong></p>
      <p class="mt-2 text-[14px] leading-snug md:mt-[1.2cqw] md:text-[1.15cqw] md:leading-[1.15] max-md:[&_br]:hidden">
        Chris Smiley, O.D., is the CEO of <br />Vision Professionals in Columbus, <br />OH and a <a href="https://www.vsp.com/eye-doctor" target="_blank" rel="noopener" class="underline hover:opacity-70">VSP network optometrist</a>.
      </p>
    </div>
  </div>

  <a
    href={start}
    data-reveal
    style="--reveal-delay: 450ms"
    class="group order-last flex items-center gap-2 self-center rounded-full bg-[#1D3345] px-5 py-3 text-[13px] font-medium leading-none tracking-[0.06em] text-white transition-colors hover:bg-black md:absolute md:left-[10.33%] md:top-[44.6cqw] md:gap-[0.8cqw] md:px-[2cqw] md:py-[0.9cqw] md:text-[1.15cqw]"
  >
    <ArrowCounterClockwise aria-hidden="true" class="w-4 transition-[rotate] duration-500 group-hover:-rotate-180 md:w-[1.4cqw]" />
    <span>BACK TO THE START</span>
  </a>

  <div
    data-reveal
    data-carousel
    style="--reveal-delay: 200ms"
    role="region"
    aria-roledescription="carousel"
    aria-label="Where to start"
    class="relative w-full max-w-[520px] self-center md:absolute md:left-[49.96%] md:top-[1.55cqw] md:h-[43.9cqw] md:w-[39.2cqw] md:max-w-none"
  >
    <div class="overflow-hidden rounded-[22px] border-2 border-[#7CBFCB] bg-white md:h-full md:rounded-[2.4cqw] md:border-[max(2px,0.12cqw)]">
      <div data-track class="flex transition-transform duration-500 ease-[cubic-bezier(0.22,1,0.36,1)] md:h-full">
        {
          tips.map((tip, i) => (
            <article
              class="flex w-full shrink-0 flex-col px-6 pb-7 pt-6 text-[#1D3345] md:h-full md:px-[3.73cqw] md:pb-[3.1cqw] md:pt-[3cqw]"
              aria-roledescription="slide"
              aria-label={`${i + 1} of ${tips.length}`}
              data-slide-item
              inert={i !== 0}
            >
              <header class="flex items-center gap-4 md:gap-[1.67cqw]">
                <Image src={tip.number} alt={`#${i + 1}`} widths={[tip.number.width]} sizes="(min-width: 768px) 5vw, 48px" class="h-9 w-auto shrink-0 md:h-[3.1cqw]" />
                <h3 class="text-[19px] font-bold leading-tight md:whitespace-nowrap md:text-[2cqw] md:leading-[1.04] max-md:[&_br]:hidden" set:html={tip.title.replaceAll("<br />", " <br />")} />
              </header>
              <hr class="mt-4 w-full border-0 border-t border-[#7CBFCB] md:mt-[1.5cqw] md:w-[31.56cqw]" />
              <div
                class="mt-5 flex-1 text-[15px] leading-snug md:mt-[2cqw] md:text-(length:--fs) md:leading-[1.05] [&_a]:underline [&_a:hover]:opacity-70 [&_strong]:font-bold [&_sup]:text-[0.6em] [&>p+p]:mt-[1lh]"
                style={`--fs:${tip.size}`}
              >
                {tip.paragraphs.map((p) => <p set:html={p} />)}
              </div>
              <a
                href={vspDoctor}
                target="_blank"
                rel="noopener"
                class="group/cta mt-6 inline-flex items-center gap-2 self-start text-[13px] leading-none tracking-[0.06em] hover:opacity-80 md:mt-[1cqw] md:gap-[0.9cqw] md:text-[1.22cqw] md:tracking-[0.08em]"
              >
                <span class="underline decoration-[max(1px,0.06cqw)] underline-offset-4 md:underline-offset-[0.35cqw]">Find a VSP network doctor near you</span>
                <ArrowRight aria-hidden="true" class="w-4 shrink-0 transition-[translate] duration-300 group-hover/cta:translate-x-1 md:w-[1.45cqw] md:group-hover/cta:translate-x-[0.3cqw]" />
              </a>
            </article>
          ))
        }
      </div>
    </div>

    <button
      type="button"
      data-prev
      aria-label="Previous tip"
      class="absolute -left-5 top-1/2 flex size-10 -translate-y-1/2 items-center justify-center rounded-full bg-[#7CBFCB] text-white transition-transform hover:scale-105 md:-left-[1.59cqw] md:top-[22.1cqw] md:size-[3.18cqw]"
    >
      <CaretLeft aria-hidden="true" class="w-5 md:w-[1.5cqw]" />
    </button>
    <button
      type="button"
      data-next
      aria-label="Next tip"
      class="absolute -right-5 top-1/2 flex size-10 -translate-y-1/2 items-center justify-center rounded-full bg-[#7CBFCB] text-white transition-transform hover:scale-105 md:-right-[1.59cqw] md:top-[22.1cqw] md:size-[3.18cqw]"
    >
      <CaretRight aria-hidden="true" class="w-5 md:w-[1.5cqw]" />
    </button>
  </div>

  <p class="-mt-4 text-center text-[10px] md:absolute md:left-[49.96%] md:top-[46.9cqw] md:mt-0 md:w-[39.2cqw] md:text-[max(9px,0.78cqw)]">
    Citations: 1) <a
      href="https://www.aoa.org/AOA/Documents/Healthy%20Eyes/Eye%20and%20vision%20conditions/Systemic%20Conditions%20with%20Ocular%20and%20Visual%20Manifestations.pdf"
      target="_blank"
      rel="noopener"
      class="underline hover:opacity-70">AOA</a
    >
  </p>
</section>

<script>
  document.querySelectorAll<HTMLElement>("[data-carousel]").forEach((carousel) => {
    const track = carousel.querySelector<HTMLElement>("[data-track]")!;
    const items = [...carousel.querySelectorAll<HTMLElement>("[data-slide-item]")];
    let index = 0;
    const go = (next: number) => {
      index = (next + items.length) % items.length;
      track.style.transform = `translateX(-${index * 100}%)`;
      items.forEach((item, i) => (item.inert = i !== index));
    };
    carousel.querySelector("[data-prev]")?.addEventListener("click", () => go(index - 1));
    carousel.querySelector("[data-next]")?.addEventListener("click", () => go(index + 1));
    let startX = 0;
    carousel.addEventListener("touchstart", (event) => (startX = event.touches[0].clientX), { passive: true });
    carousel.addEventListener("touchend", (event) => {
      const delta = event.changedTouches[0].clientX - startX;
      if (Math.abs(delta) > 50) go(index + (delta < 0 ? 1 : -1));
    });
    carousel.addEventListener("keydown", (event) => {
      if (event.key === "ArrowLeft") go(index - 1);
      if (event.key === "ArrowRight") go(index + 1);
    });
  });
</script>
