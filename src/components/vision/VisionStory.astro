---
import Hero from "./Hero.astro";
import StayActive from "./StayActive.astro";
import StayConnected from "./StayConnected.astro";
import PursuePassions from "./PursuePassions.astro";
import VisionSupport from "./VisionSupport.astro";
---

<div data-slides>
  <div id="clearer-look" data-slide>
    <Hero next="#stay-active" />
  </div>
  <div id="stay-active" data-slide hidden>
    <StayActive next="#stay-connected" />
  </div>
  <div id="stay-connected" data-slide hidden>
    <StayConnected next="#pursue-passions" />
  </div>
  <div id="pursue-passions" data-slide hidden>
    <PursuePassions next="#vision-support" />
  </div>
  <div id="vision-support" data-slide hidden>
    <VisionSupport start="#clearer-look" />
  </div>
</div>

<script>
  const slides = [...document.querySelectorAll<HTMLElement>("[data-slide]")];

  const slideFor = (hash: string) => {
    const target = hash.length > 1 ? document.getElementById(decodeURIComponent(hash.slice(1))) : null;
    return target?.closest<HTMLElement>("[data-slide]") ?? slides[0];
  };

  const show = (slide: HTMLElement, animate: boolean) => {
    if (!slide.hidden) return;
    slides.forEach((s) => (s.hidden = s !== slide));
    if (animate) {
      slide.classList.remove("slide-enter");
      void slide.offsetWidth;
      slide.classList.add("slide-enter");
    }
    window.scrollTo({ top: 0, behavior: "instant" });
  };

  document.addEventListener("click", (event) => {
    const link = (event.target as Element).closest<HTMLAnchorElement>('a[href^="#"]');
    if (!link) return;
    const id = link.getAttribute("href")!.slice(1);
    const target = id ? document.getElementById(id) : null;
    if (!target || !target.hasAttribute("data-slide")) return;
    event.preventDefault();
    history.pushState(null, "", `#${id}`);
    show(target, true);
  });

  window.addEventListener("popstate", () => show(slideFor(location.hash), true));

  show(slideFor(location.hash), false);

  const loaded = (img: HTMLImageElement | null) =>
    !img || img.complete
      ? Promise.resolve()
      : new Promise<void>((resolve) => {
          img.addEventListener("load", () => resolve(), { once: true });
          img.addEventListener("error", () => resolve(), { once: true });
        });

  const reveal = (el: Element) => {
    const img = el instanceof HTMLImageElement ? el : el.querySelector("img");
    loaded(img).then(() => requestAnimationFrame(() => el.classList.add("is-revealed")));
  };

  const start = () => {
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (!entry.isIntersecting) return;
          reveal(entry.target);
          observer.unobserve(entry.target);
        });
      },
      { threshold: 0.2, rootMargin: "100000px 0px -8% 0px" },
    );
    document.querySelectorAll("[data-reveal]").forEach((item) => observer.observe(item));
  };

  const firstBg = document.querySelector<HTMLImageElement>("[data-slide]:not([hidden]) img");
  const timeout = new Promise<void>((resolve) => setTimeout(resolve, 2500));
  Promise.race([Promise.all([loaded(firstBg), document.fonts.ready]), timeout]).then(() => setTimeout(start, 150));
</script>
