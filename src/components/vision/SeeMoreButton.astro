---
import ArrowRight from "@phosphor-icons/core/assets/regular/arrow-right.svg";

export interface Props {
  href: string;
  class?: string;
  style?: string;
  delay?: string;
}
const { href, class: className, style = "", delay = "350ms" } = Astro.props;
---

<a
  href={href}
  data-reveal
  style={`--reveal-delay: ${delay}; ${style}`}
  class:list={[
    "group absolute left-1/2 flex -translate-x-1/2 -translate-y-1/2 items-center gap-[1cqw] rounded-full bg-white px-[2.6cqw] py-[1.1cqw] text-[1.75cqw] font-medium leading-none tracking-[0.06em] text-black mix-blend-screen",
    className,
  ]}
>
  <span>SEE MORE</span>
  <ArrowRight aria-hidden="true" class="w-[2cqw] transition-[translate] duration-300 group-hover:translate-x-[0.4cqw]" />
</a>
