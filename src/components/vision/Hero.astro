---
import { Image } from "astro:assets";
import SeeMoreButton from "./SeeMoreButton.astro";
import MobileHalfBg from "./MobileHalfBg.astro";
import bg from "../../assets/vision/hero-bg.png";
import logo from "../../assets/vision/logo-mbg-vsp.png";
import titleLine1 from "../../assets/vision/title-line-1.png";
import titleLine2 from "../../assets/vision/title-line-2.png";
import tagline from "../../assets/vision/tagline.png";

export interface Props {
  next: string;
}
const { next } = Astro.props;
---

<section class="@container relative isolate w-full overflow-hidden text-white md:aspect-[1395/1550]" aria-labelledby="vision-hero-title">
  <Image
    src={bg}
    alt=""
    widths={[768, 1280, 1920, 2880]}
    sizes="106vw"
    loading="eager"
    fetchpriority="high"
    class="absolute -left-[3%] -top-[1.6cqw] -z-10 h-[calc(100%+1.6cqw)] w-[106%] max-w-none object-cover object-top max-md:hidden"
  />

  <div class="relative isolate flex min-h-svh flex-col items-center justify-center gap-7 overflow-hidden px-6 py-16 md:contents">
    <MobileHalfBg src={bg} half="top" />

    <Image
      src={logo}
      alt="mindbodygreen x VSP Vision Care"
      widths={[450, 899]}
      sizes="(min-width: 768px) 31cqw, 72vw"
      data-reveal
      class="w-[72%] max-w-[320px] md:absolute md:left-[34.27%] md:top-[14.7cqw] md:w-[30.75%] md:max-w-none"
    />

    <h2 id="vision-hero-title" class="w-full max-w-[460px] md:absolute md:left-[19.43%] md:top-[21.86cqw] md:w-[61.2%] md:max-w-none">
      <Image src={titleLine1} alt="a clearer look" widths={[871, 1742]} sizes="(min-width: 768px) 62cqw, 100vw" data-reveal style="--reveal-delay: 150ms" class="block w-full" />
      <Image src={titleLine2} alt="at healthy aging" widths={[871, 1742]} sizes="(min-width: 768px) 62cqw, 100vw" data-reveal style="--reveal-delay: 300ms" class="-mt-[0.4%] block w-full" />
    </h2>

    <p data-reveal style="--reveal-delay: 450ms" class="max-w-[420px] text-center text-[17px] leading-snug md:absolute md:inset-x-0 md:top-[39.9cqw] md:max-w-none md:text-[2.007cqw] md:leading-[1.1]">
      A pillar of longevity that deserves a closer look? <br class="max-md:hidden" />
      Keep scrolling to bring the bigger picture into focus.
    </p>
  </div>

  <div class="relative isolate flex min-h-svh flex-col items-center justify-center gap-10 overflow-hidden bg-black px-6 py-16 md:contents">
    <MobileHalfBg src={bg} half="bottom" />

    <p class="text-center text-[17px] leading-snug md:absolute md:left-1/2 md:top-[66.4cqw] md:-translate-x-1/2 md:whitespace-nowrap md:text-[2.007cqw] md:leading-[1.07]">
      <span data-reveal class="block"><strong class="font-bold">Healthy vision</strong> helps us…</span>
      <span data-reveal style="--reveal-delay: 150ms" class="block">Move confidently through the world…</span>
      <span data-reveal style="--reveal-delay: 300ms" class="block">Connect us to the people around us…</span>
      <span data-reveal style="--reveal-delay: 450ms" class="block">And ensure we can continue doing <br class="max-md:hidden" />the things that matter…</span>
    </p>

    <Image
      src={tagline}
      alt="seeing well is living well is aging well"
      widths={[1122, 2245]}
      sizes="(min-width: 768px) 76cqw, 100vw"
      data-reveal
      style="--reveal-delay: 200ms"
      class="w-full max-w-[520px] md:absolute md:left-[11.9%] md:top-[82cqw] md:w-[76.2%] md:max-w-none"
    />

    <SeeMoreButton href={next} top="94.3cqw" />
  </div>
</section>
