---
import Logo from "../assets/logo-mindbodygreen.svg";
import EnvelopeSimple from "@phosphor-icons/core/assets/regular/envelope-simple.svg";
import MagnifyingGlass from "@phosphor-icons/core/assets/regular/magnifying-glass.svg";
import User from "@phosphor-icons/core/assets/regular/user.svg";

const sections = [
  { label: "READ", href: "/", active: true },
  { label: "LEARN", href: "https://institute.mindbodygreen.com/health-coach-certification" },
  { label: "LISTEN", href: "https://podcasts.apple.com/us/podcast/the-mindbodygreen-podcast/id1246494475" },
];
const shop = "https://shop.mindbodygreen.com";
---

<nav id="article-navigation" class="sticky top-0 z-40 border-b border-[#d9d9d9] bg-white text-[#272727] lg:border-[#f1f1f1]">
  <div class="flex h-[52px] items-center justify-between px-5 lg:h-[78px] lg:px-10">
    <a href="/" aria-label="mindbodygreen home" class="flex shrink-0 items-center">
      <Logo role="img" aria-label="mindbodygreen" class="h-auto w-[158px] text-black lg:w-[170px]" />
    </a>

    <div class="flex items-center">
      <div class="hidden items-center gap-9 text-[17px] font-medium tracking-[0.14em] lg:flex">
        {
          sections.map((s) => (
            <a href={s.href} class:list={["transition-colors hover:text-[#2360B2]", s.active && "text-[#2360B2]"]}>
              {s.label}
            </a>
          ))
        }
        <span class="h-[30px] w-px bg-black"></span>
        <a href={shop} class="-ml-4 font-bold hover:text-[#2360B2]">SHOP</a>
        <span class="-ml-4 h-[30px] w-px bg-black"></span>
      </div>

      <div class="flex items-center gap-[14px] lg:ml-7 lg:gap-[18px]">
        <a href="/newsletters" aria-label="Newsletters" class="hover:opacity-70">
          <EnvelopeSimple aria-hidden="true" class="size-[22px] lg:size-[23px]" />
        </a>
        <a href="/search" aria-label="Search" class="hover:opacity-70">
          <MagnifyingGlass aria-hidden="true" class="size-[22px] lg:size-[23px]" />
        </a>
        <a href="/account/login" aria-label="Account" class="hover:opacity-70">
          <User aria-hidden="true" class="size-[22px] lg:size-[23px]" />
        </a>
      </div>
    </div>
  </div>

  <div class="flex h-[33px] items-center justify-between border-t border-[#d9d9d9] px-6 text-[11px] font-medium tracking-[0.06em] lg:hidden">
    {
      sections.map((s) => (
        <a href={s.href} class:list={["transition-colors hover:text-[#2360B2]", s.active && "text-[#2360B2]"]}>
          {s.label}
        </a>
      ))
    }
    <span class="h-[17px] w-px bg-[#bdbdbd]" aria-hidden="true"></span>
    <a href={shop} class="font-bold hover:text-[#2360B2]">SHOP</a>
  </div>
</nav>
